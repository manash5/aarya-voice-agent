LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# English agent (agent.py / rag_agent.py) - Deepgram STT + TTS
DEEPGRAM_API_KEY=your-api-secret
GROQ_API_KEY=your-api-secret

# nepali_agent.py - STT needs AssemblyAI; TTS is Cartesia Hindi via LiveKit Inference
ASSEMBLYAI_API_KEY=your-api-secret

# gemini_realtime_agent.py
GOOGLE_API_KEY=your-api-secret

# Optional LLM fallbacks via LiveKit Inference
OPENAI_API_KEY=your-api-secret

# Google Calendar (agent.py CalendarAssistant)
GOOGLE_CALENDAR_ID=you@gmail.com
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service-account.json
GOOGLE_CALENDAR_TIMEZONE=Asia/Kathmandu


MISTRAL_API_KEY=your-api-secret
